# Pinned to the last upstream build before PR #1171 (2026-02-14) deleted
# dataload.dockersh. Keep in lockstep with docker-compose.yml image pins.
FROM ghcr.io/ebispot/ols4-dataload:a7fb62ffb006671fba21a3e62164c7b6a25a7ae7

USER root
RUN rm -rf /opt/neo4j/data && \
    mkdir -p /var/lib/neo4j/data && \
    ln -s /var/lib/neo4j/data /opt/neo4j/data
